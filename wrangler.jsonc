{
  // edge-shield -- working configuration.
  //
  // Replace every <REPLACE_...> placeholder before deploying. See
  // wrangler.example.jsonc for a fully commented multi-zone reference, and
  // docs/cloudflare-setup.md for the dashboard side.
  //
  // Requires Wrangler >= 4.36.0 for the `ratelimits` binding.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edge-shield",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",

  // Workers Logs. `wrangler tail` streams the same lines live.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Dynamic per-site config overrides. Create with:
  //   npx wrangler kv namespace create SHIELD_CONFIG
  "kv_namespaces": [
    {
      "binding": "SHIELD_CONFIG",
      "id": "<REPLACE_WITH_KV_NAMESPACE_ID>"
    }
  ],

  // Rate limiting bindings.
  //
  // The limit and the period are fixed HERE, at deploy time -- the runtime API only takes
  // a key. Keep these numbers in sync with the `rateLimits` values in src/config/sites.ts
  // (or the KV override), which are what the logs and the Retry-After header report.
  //
  // `period` must be exactly 10 or 60. `namespace_id` is any positive integer, unique per
  // limit; bindings sharing a namespace_id share one counter.
  "ratelimits": [
    {
      "name": "RL_LOGIN",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RL_XMLRPC",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "RL_COMMENTS",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RL_GENERAL",
      "namespace_id": "1004",
      "simple": { "limit": 100, "period": 60 }
    }
  ],

  // One entry per hostname the Worker should run on. The zone must be proxied
  // (orange cloud) and live in the same Cloudflare account as this Worker.
  "routes": [
    { "pattern": "example.com/*", "zone_name": "example.com" },
    { "pattern": "www.example.com/*", "zone_name": "example.com" },
    { "pattern": "app.example.net/*", "zone_name": "example.net" }
  ]

  // Secrets are NOT set here. Use:
  //   npx wrangler secret put SHIELD_ADMIN_TOKEN
  //   npx wrangler secret put SHIELD_COOKIE_SECRET     (only if challenge is enabled)
  //   npx wrangler secret put TURNSTILE_SECRET_KEY     (only if challenge is enabled)
}
